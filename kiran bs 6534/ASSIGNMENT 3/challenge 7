#include <stdio.h>

int main() {
    char str[100];
    int length = 0, i;
    int vowels = 0;
    int isPalindrome = 1;

    // Input string
    printf("Enter a string: ");
    scanf("%s", str);

    // Find length manually
    while (str[length] != '\0') {
        length++;
    }

    // Reverse string (manual)
    printf("Reversed string: ");
    for (i = length - 1; i >= 0; i--) {
        printf("%c", str[i]);
    }
    printf("\n");

    // Count vowels
    for (i = 0; i < length; i++) {
        char ch = str[i];
        if (ch == 'a' || ch == 'e' || ch == 'i' ||
            ch == 'o' || ch == 'u' ||
            ch == 'A' || ch == 'E' || ch == 'I' ||
            ch == 'O' || ch == 'U') {
            vowels++;
        }
    }
    printf("Vowel count: %d\n", vowels);

    // Palindrome check
    for (i = 0; i < length / 2; i++) {
        if (str[i] != str[length - 1 - i]) {
            isPalindrome = 0;
            break;
        }
    }

    if (isPalindrome)
        printf("The string is a palindrome\n");
    else
        printf("The string is not a palindrome\n");

    return 0;
}
